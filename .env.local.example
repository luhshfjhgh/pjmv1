# ============================================================
# PJM - Presença Jovem Missionário
# Variáveis de Ambiente
# ============================================================
# Copie este arquivo para .env.local e preencha com seus dados

# Supabase - URL e chave pública (anon key)
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_aqui

# Supabase - chave de serviço (service role key) - NUNCA exponha no frontend
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# Segredo para assinar os tokens JWT de sessão (gere uma string aleatória longa)
JWT_SECRET=seu_segredo_jwt_super_secreto_aqui_minimo_32_caracteres

# URL base da aplicação
NEXT_PUBLIC_APP_URL=http://localhost:3000
